{
  "name": "best-fireworks",
  "private": true,
  "version": "1.3.0",
  "description": "Best FireWorks – Diwali order booking website and Android app",
  "type": "module",
  "scripts": {
    "prices": "node scripts/build-price-list.mjs && node scripts/copy-vendor.mjs",
    "dev": "npm run prices && vite --host",
    "dev:live": "npm run prices && vite --host --mode live",
    "emulators": "firebase emulators:start --only auth,firestore,storage,functions --project demo-best-fireworks",
    "seed": "node scripts/seed-emulator.mjs",
    "test:e2e": "node scripts/e2e-emulator.mjs",
    "build": "npm run prices && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && firebase deploy --only hosting,firestore,storage",
    "deploy:rules": "firebase deploy --only firestore,storage",
    "deploy:backend": "cd functions && npm install && cd .. && firebase deploy --only firestore,storage,functions",
    "deploy:functions": "npm --prefix functions install && firebase deploy --only functions",
    "build:app": "npm run build && node scripts/make-app-web.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/share": "^8.0.3",
    "@techstark/opencv-js": "4.12.0-release.1",
    "firebase": "^13.1.0",
    "jspdf": "^4.2.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "vite": "^7.3.7"
  }
}

{
  "hosting": [
    {
      "site": "bestfireworks",
      "public": "dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "cleanUrls": true,
      "redirects": [],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/assets/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "/data/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            },
            {
              "key": "Access-Control-Allow-Origin",
              "value": "*"
            }
          ]
        }
      ]
    },
    {
      "site": "best-fireworks",
      "public": "dist",
      "ignore": [
        "**"
      ],
      "redirects": [
        {
          "regex": "^/(?P<path>.*)$",
          "destination": "https://bestfireworks.web.app/:path",
          "type": 301
        }
      ]
    },
    {
      "site": "best-fireworks-98d13",
      "public": "dist",
      "ignore": [
        "**"
      ],
      "redirects": [
        {
          "regex": "^/(?P<path>.*)$",
          "destination": "https://bestfireworks.web.app/:path",
          "type": 301
        }
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "singleProjectMode": true,
    "auth": {
      "host": "0.0.0.0",
      "port": 9099
    },
    "firestore": {
      "host": "0.0.0.0",
      "port": 8080
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "storage": {
      "host": "0.0.0.0",
      "port": 9199
    }
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "*.local"
      ]
    }
  ]
}

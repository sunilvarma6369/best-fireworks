rules_version = '2';

// Item photos uploaded from the admin page, compressed in the browser: a list picture (≤ 25 KB) and a zoom picture (≤ 180 KB).
service firebase.storage {
  match /b/{bucket}/o {
    // Admin or super admin (sales staff cannot change item photos). Same roles as firestore.rules.
    function isAdmin() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.get('active', true) == true
        && firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.get('role', 'admin') in ['admin', 'super'];
    }

    match /products/{file} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.size < 300 * 1024
        && request.resource.contentType.matches('image/(webp|jpeg)');
      allow delete: if isAdmin();
    }
  }
}
